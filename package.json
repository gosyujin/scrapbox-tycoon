{
  "name": "scrapbox-tycoon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc && tsc -p cm-editor/tsconfig.json && node scripts/build-cm-editor.mjs && node scripts/write-build-info.mjs && node scripts/cache-bust-imports.mjs",
    "watch": "tsc --watch",
    "dev": "npm run build && node server.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "typecheck:cm": "tsc -p cm-editor/tsconfig.json"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
